# Run from the repository root; npm run docs:api sets the working directory.
PROJECT_NAME           = ilias
PROJECT_BRIEF          = "Modern Lightweight C++ Async Runtime"
OUTPUT_DIRECTORY       = docs/public
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = include
STRIP_FROM_INC_PATH    = include

INPUT                  = include docs/doxygen/mainpage.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/*
EXCLUDE_SYMBOLS        = ilias::detail ilias::detail::*
USE_MDFILE_AS_MAINPAGE = docs/doxygen/mainpage.md
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
INTERNAL_DOCS          = NO
HIDE_UNDOC_RELATIONS   = YES
SORT_BRIEF_DOCS        = YES

# Parse the public headers without building the library or its dependencies.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "ILIAS_NS_BEGIN=namespace ilias {" \
                         "ILIAS_NS_END=}" \
                         ILIAS_API= \
                         ILIAS_EXPORT= \
                         ILIAS_EXPORT_BEGIN= \
                         ILIAS_EXPORT_END= \
                         ILIAS_STATIC=1 \
                         "ILIAS_GNUC(...)=__VA_ARGS__" \
                         ILIAS_CORO_AWAIT_ELIDABLE= \
                         ILIAS_CORO_ELIDABLE_ARGUMENT=

GENERATE_HTML          = YES
HTML_OUTPUT            = api
HTML_EXTRA_STYLESHEET  = docs/doxygen/theme/doxygen-awesome.css
HTML_EXTRA_FILES       = docs/doxygen/theme/LICENSE
HTML_COLORSTYLE        = LIGHT
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
HAVE_DOT               = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
